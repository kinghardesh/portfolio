---
import profile from "../data/profile.json";
import { links } from "../data/links";

const [first, ...rest] = profile.name.split(" ");
---

<section class="hero">
  <div class="wrap inner">
    <p class="status mono"><span class="pulse" aria-hidden="true"></span>{profile.availability}</p>
    <h1>Hi, I'm <span class="accent">{first}</span>{rest.length ? ` ${rest.join(" ")}` : ""}</h1>
    <p class="role">{profile.role}</p>
    <p class="study mono">{profile.studyLine}</p>
    <p class="pitch">{profile.pitch}</p>
    <div class="actions">
      <a class="btn primary" href={profile.resume} download>My Resume</a>
      <a class="btn" href="#ask" data-open-chat>Ask me anything</a>
    </div>
    <div class="socials">
      {links.github && (<a href={links.github} rel="me" aria-label="GitHub">
        <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true"><path fill="currentColor" d="M12 2a10 10 0 0 0-3.2 19.5c.5.1.7-.2.7-.5v-1.7c-2.8.6-3.4-1.3-3.4-1.3-.5-1.2-1.1-1.5-1.1-1.5-.9-.6.1-.6.1-.6 1 .1 1.5 1 1.5 1 .9 1.5 2.4 1.1 2.9.8.1-.7.4-1.1.6-1.3-2.2-.3-4.6-1.1-4.6-5a3.9 3.9 0 0 1 1-2.7c-.1-.3-.5-1.3.1-2.7 0 0 .9-.3 2.8 1a9.6 9.6 0 0 1 5 0c1.9-1.3 2.8-1 2.8-1 .6 1.4.2 2.4.1 2.7a3.9 3.9 0 0 1 1 2.7c0 3.9-2.3 4.7-4.6 5 .4.3.7.9.7 1.9V21c0 .3.2.6.7.5A10 10 0 0 0 12 2z"/></svg>
      </a>)}
      {links.linkedin && (<a href={links.linkedin} rel="me" aria-label="LinkedIn">
        <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true"><path fill="currentColor" d="M4.98 3.5a2.5 2.5 0 1 1 0 5 2.5 2.5 0 0 1 0-5zM3 9h4v12H3zM9 9h3.8v1.7h.1c.5-1 1.8-2 3.8-2 4 0 4.8 2.6 4.8 6V21h-4v-5.6c0-1.3 0-3-1.9-3s-2.1 1.4-2.1 2.9V21H9z"/></svg>
      </a>)}
      <a href={`mailto:${profile.email}`} aria-label="Email">
        <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true"><path d="M3 6.5A1.5 1.5 0 0 1 4.5 5h15A1.5 1.5 0 0 1 21 6.5v11a1.5 1.5 0 0 1-1.5 1.5h-15A1.5 1.5 0 0 1 3 17.5z" fill="none" stroke="currentColor" stroke-width="1.8"/><path d="M3.5 6.5l8.5 6.5 8.5-6.5" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"/></svg>
      </a>
    </div>
  </div>
</section>

<style>
  .hero { min-height: calc(100vh - 64px); min-height: calc(100svh - 64px); display: grid; align-items: center; padding: 48px 0 72px; }
  .inner { display: flex; flex-direction: column; align-items: center; text-align: center; }
  .status {
    display: inline-flex; align-items: center; gap: 10px; font-size: 0.8rem; color: var(--muted);
    padding: 6px 14px; border: 1px solid var(--border); border-radius: 999px; margin-bottom: 28px;
    background: color-mix(in srgb, var(--surface) 60%, transparent); backdrop-filter: blur(6px);
  }
  .pulse { width: 8px; height: 8px; border-radius: 50%; background: var(--ok); animation: pulse 2s infinite; flex: none; }
  @keyframes pulse {
    0% { box-shadow: 0 0 0 0 color-mix(in srgb, var(--ok) 60%, transparent); }
    100% { box-shadow: 0 0 0 10px transparent; }
  }
  h1 { font-size: clamp(2.6rem, 8vw, 5rem); font-weight: 800; margin: 0 0 12px; }
  .role { font-family: var(--display); font-weight: 600; font-size: clamp(1.05rem, 2.6vw, 1.4rem); color: var(--muted); margin: 0 0 8px; }
  .study { font-size: 0.82rem; color: var(--muted); letter-spacing: 0.02em; margin: 0 0 24px; }
  .pitch { font-size: clamp(1.05rem, 2.2vw, 1.25rem); max-width: 34ch; margin: 0 0 36px; }
  .actions { display: flex; flex-wrap: wrap; justify-content: center; gap: 12px; }
  .socials { display: flex; gap: 10px; margin-top: 32px; }
  .socials a {
    display: grid; place-items: center; width: 42px; height: 42px; border-radius: 50%;
    color: var(--muted); border: 1px solid var(--border); transition: color 0.15s, border-color 0.15s;
  }
  .socials a:hover { color: var(--accent); border-color: var(--accent); }
  @media (prefers-reduced-motion: reduce) { .pulse { animation: none; } }
</style>

---
import profile from "../data/profile.json";
---

<header class="site-header">
  <div class="wrap bar">
    <a href="/" class="brand mono" aria-label="Home">
      <span class="dot" aria-hidden="true"></span>{profile.initials}
    </a>
    <nav aria-label="Primary">
      <a href="/#projects">Projects</a>
      <a href="/#skills" class="hide-sm">Skills</a>
      <a href="/#ask" data-open-chat>Ask</a>
      <a href="/#contact">Contact</a>
      <a href={profile.resume} class="hide-sm">Resume</a>
      <button class="theme-toggle" type="button" aria-label="Toggle light and dark theme">
        <svg class="sun" viewBox="0 0 24 24" width="18" height="18" aria-hidden="true">
          <circle cx="12" cy="12" r="4" fill="none" stroke="currentColor" stroke-width="2" />
          <path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
        </svg>
        <svg class="moon" viewBox="0 0 24 24" width="18" height="18" aria-hidden="true">
          <path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z" fill="none" stroke="currentColor" stroke-width="2" stroke-linejoin="round" />
        </svg>
      </button>
    </nav>
  </div>
</header>

<script>
  const btn = document.querySelector<HTMLButtonElement>(".theme-toggle");
  btn?.addEventListener("click", () => {
    const root = document.documentElement;
    const current =
      root.dataset.theme ?? (matchMedia("(prefers-color-scheme: light)").matches ? "light" : "dark");
    const next = current === "light" ? "dark" : "light";
    root.dataset.theme = next;
    try {
      localStorage.setItem("theme", next);
    } catch {}
  });
</script>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 10;
    background: color-mix(in srgb, var(--bg) 85%, transparent);
    backdrop-filter: blur(8px);
    border-bottom: 1px solid var(--border);
  }
  .bar { display: flex; align-items: center; justify-content: space-between; height: 56px; }
  .brand { display: flex; align-items: center; gap: 8px; color: var(--text); text-decoration: none; font-weight: 500; }
  .dot { width: 8px; height: 8px; border-radius: 50%; background: var(--accent); box-shadow: 0 0 10px var(--accent); }
  nav { display: flex; align-items: center; gap: 4px; }
  nav a { color: var(--muted); text-decoration: none; font-size: 0.9rem; padding: 6px 10px; border-radius: 6px; }
  nav a:hover { color: var(--text); background: var(--surface); }
  .theme-toggle {
    display: grid; place-items: center; width: 34px; height: 34px; margin-left: 4px;
    background: none; border: 1px solid var(--border); border-radius: 8px; color: var(--muted); cursor: pointer;
  }
  .theme-toggle:hover { color: var(--text); }
  .sun { display: none; }
  :global(:root[data-theme="dark"]) .sun { display: block; }
  :global(:root[data-theme="dark"]) .moon { display: none; }
  :global(:root[data-theme="light"]) .moon { display: block; }
  @media (prefers-color-scheme: dark) {
    :global(:root:not([data-theme="light"])) .sun { display: block; }
    :global(:root:not([data-theme="light"])) .moon { display: none; }
  }
  @media (max-width: 480px) {
    .hide-sm { display: none; }
    nav a { padding: 6px 7px; }
  }
</style>
